{
  "name": "fmi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:icon-sprite": "node scripts/generate-icon-sprite.js",
    "predev": "npm run generate:icon-sprite",
    "dev": "next dev",
    "prebuild": "npm run generate:icon-sprite",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "prestorybook": "npm run generate:icon-sprite",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run generate:icon-sprite",
    "build-storybook": "storybook build",
    "prepare": "husky",
    "chromatic": "npx chromatic --project-token=$CHROMATIC_PROJECT_TOKEN",
    "test:ci": "jest --ci --runInBand",
    "check:all": "run-s test build test:e2e build-storybook",
    "check:fast": "run-p test test:e2e build-storybook",
    "analyze": "ANALYZE=true next build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:ci": "npm run build && playwright test",
    "lint:i18n-literal": "eslint \"src/**/*.{ts,tsx}\"",
    "check:i18n-keys": "node scripts/check-i18n-keys.js"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.9",
    "@capacitor/ios": "^7.6.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/is-prop-valid": "^1.4.0",
    "@hookform/resolvers": "^5.4.0",
    "@next/third-parties": "^16.4.2",
    "@sentry/nextjs": "^10.76.2",
    "@stomp/stompjs": "^7.5.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "axios": "^1.20.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "clsx": "^2.1.1",
    "cookies-next": "^6.1.1",
    "date-fns": "^4.1.0",
    "es-toolkit": "^1.52.0",
    "framer-motion": "^12.27.0",
    "next": "^15.5.28",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-intersection-observer": "^10.0.2",
    "react-naver-maps": "^0.2.2",
    "sockjs-client": "^1.6.1",
    "swiper": "^12.1.2",
    "xml2js": "^0.6.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "postcss": "$postcss",
    "next": {
      "sharp": "^0.35.5"
    }
