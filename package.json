    "autoprefixer": "^10.6.1",
    "babel-jest": "^29.7.0",
    "chromatic": "^13.3.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-junit": "^17.0.0",
    "jest-transformer-svg": "^2.1.0",
    "lint-staged": "^16.1.5",
    "msw": "^2.12.7",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.55.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.3",
    "tailwindcss": "^3.4.13",
    "ts-jest": "^29.4.15",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "junit.xml"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
